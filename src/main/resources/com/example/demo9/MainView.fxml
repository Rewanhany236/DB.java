<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1100.0"
            style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #334155);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo9.controller.MainController">

    <children>

        <VBox alignment="CENTER"
              spacing="25.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <children>

                <Label text="Hello To Industrial Database"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="36.0"/>
                    </font>
                </Label>

                <Label text="Equipment Rental Management System"
                       textFill="#d1d5db">
                    <font>
                        <Font size="18.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0"/>
                    </VBox.margin>
                </Label>

                <Button text="Contractors"
                        onAction="#openContractor"
                        prefHeight="55.0"
                        prefWidth="320.0"
                        style="-fx-background-color:#8e44ad;
                               -fx-text-fill:white;
                               -fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:15;"/>

                <Button text="Equipment"
                        onAction="#openEquipment"
                        prefHeight="55.0"
                        prefWidth="320.0"
                        style="-fx-background-color:#2980b9;
                               -fx-text-fill:white;
                               -fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:15;"/>

                <Button text="Rental Agreements"
                        onAction="#openRental"
                        prefHeight="55.0"
                        prefWidth="320.0"
                        style="-fx-background-color:#27ae60;
                               -fx-text-fill:white;
                               -fx-font-size:18px;
                               -fx-font-weight:bold;
                               -fx-background-radius:15;"/>

            </children>
        </VBox>
    </children>
</AnchorPane>