<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo9.controller.EquipmentController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Equipment Management" textFill="#8e44ad">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <Label text="Equipment Details" textFill="#8e44ad">
                                    <font> <Font name="System Bold" size="14.0" /> </font>
                                </Label>
                                <TextField fx:id="idField" promptText="Equipment ID" />
                                <TextField fx:id="modelField" promptText="Model Name" />
                                <TextField fx:id="powerField" promptText="Engine Power" />
                                <TextField fx:id="rateField" promptText="Hourly Rate" />
                                <TextField fx:id="statusField" promptText="Status (Available/Rented)" />
                                <TextField fx:id="typeField" promptText="Equipment Type" />
                                <Separator prefWidth="200.0" />
                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button onAction="#handleInsert" prefWidth="80.0" style="-fx-background-color: #27ae60;" text="Insert" textFill="WHITE" />
                                        <Button onAction="#handleUpdate" prefWidth="80.0" style="-fx-background-color: #2980b9;" text="Update" textFill="WHITE" />
                                        <Button onAction="#handleDelete" prefWidth="80.0" style="-fx-background-color: #c0392b;" text="Delete" textFill="WHITE" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <MenuButton fx:id="columnFilterMenu" text="Filter Columns">
                                            <items>
                                                <CheckMenuItem fx:id="menuId" selected="true" text="ID" onAction="#handleColumnVisibility"/>
                                                <CheckMenuItem fx:id="menuModel" selected="true" text="Model" onAction="#handleColumnVisibility"/>
                                                <CheckMenuItem fx:id="menuPower" selected="true" text="Power" onAction="#handleColumnVisibility"/>
                                                <CheckMenuItem fx:id="menuRate" selected="true" text="Rate" onAction="#handleColumnVisibility"/>
                                                <CheckMenuItem fx:id="menuStatus" selected="true" text="Status" onAction="#handleColumnVisibility"/>
                                            </items>
                                        </MenuButton>
                                        <Button onAction="#handleViewData" text="Refresh Table" />
                                    </children>
                                </HBox>
                                <TableView fx:id="equipmentTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                                        <TableColumn fx:id="colModel" prefWidth="150.0" text="Model" />
                                        <TableColumn fx:id="colPower" prefWidth="100.0" text="Power" />
                                        <TableColumn fx:id="colRate" prefWidth="100.0" text="Rate" />
                                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>