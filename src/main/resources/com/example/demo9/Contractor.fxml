<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo9.controller.ContractorController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Contractor Management" textFill="#8e44ad">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Left Panel - Form -->
                        <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <Label text="Contractor Details" textFill="#8e44ad">
                                    <font> <Font name="System Bold" size="14.0" /> </font>
                                </Label>

                                <TextField fx:id="contractorIdField" promptText="Contractor ID" />
                                <TextField fx:id="companyNameField" promptText="Company Name" />
                                <TextField fx:id="creditLimitField" promptText="Credit Limit" />
                                <TextField fx:id="addressField" promptText="Address" />
                                <TextField fx:id="emailField" promptText="Email" />
                                <TextField fx:id="phoneField" promptText="Phone" />

                                <Separator />

                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button onAction="#handleInsert" prefWidth="80.0" style="-fx-background-color: #27ae60;" text="Insert" textFill="WHITE" />
                                        <Button onAction="#handleUpdate" prefWidth="80.0" style="-fx-background-color: #2980b9;" text="Update" textFill="WHITE" />
                                        <Button onAction="#handleDelete" prefWidth="80.0" style="-fx-background-color: #c0392b;" text="Delete" textFill="WHITE" />
                                    </children>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button onAction="#handleSelect" prefWidth="100.0" style="-fx-background-color: #f39c12;" text="Search" textFill="WHITE" />
                                        <Button onAction="#handleRefresh" prefWidth="100.0" style="-fx-background-color: #95a5a6;" text="Refresh" textFill="WHITE" />
                                    </children>
                                </HBox>

                                <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #7f8c8d;" />
                            </children>
                        </VBox>

                        <!-- Right Panel - Table -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TableView fx:id="contractorTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colContractorId" prefWidth="80.0" text="ID" />
                                        <TableColumn fx:id="colCompanyName" prefWidth="200.0" text="Company Name" />
                                        <TableColumn fx:id="colCreditLimit" prefWidth="100.0" text="Credit Limit" />
                                        <TableColumn fx:id="colAddress" prefWidth="200.0" text="Address" />
                                        <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                                        <TableColumn fx:id="colPhone" prefWidth="150.0" text="Phone" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>