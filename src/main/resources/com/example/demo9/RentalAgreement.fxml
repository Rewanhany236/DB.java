<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1300.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo9.controller.RentalAgreementController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <!-- Go Back Button -->
                <Button text="← Go Back" onAction="#handleGoBack" prefWidth="120"
                        style="-fx-background-color:#34495e; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10;" />

                <!-- Title -->
                <Label text="Rental Agreement Management" textFill="#8e44ad">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Main Content -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Left Panel - Form -->
                        <VBox prefWidth="380.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <Label text="Rental Agreement Details" textFill="#34495e">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>

                                <TextField fx:id="rentalIdField" promptText="Rental ID" />
                                <TextField fx:id="contractorIdField" promptText="Contractor ID" />
                                <TextField fx:id="contractorNameField" promptText="Company Name" editable="false"
                                           style="-fx-background-color: #f0f0f0; -fx-text-fill: #555;" />

                                <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="350.0" />
                                <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="350.0" />

                                <TextField fx:id="totalCostField" promptText="Total Cost" />
                                <TextField fx:id="totalHoursField" promptText="Total Hours" />
                                <TextField fx:id="rentalStatusField" promptText="Rental Status (Active/Completed/Cancelled)" />

                                <Separator />

                                <!-- Buttons -->
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Button onAction="#handleInsert" prefWidth="90.0"
                                                style="-fx-background-color: #27ae60;" text="Insert" textFill="WHITE" />
                                        <Button onAction="#handleUpdate" prefWidth="90.0"
                                                style="-fx-background-color: #2980b9;" text="Update" textFill="WHITE" />
                                        <Button onAction="#handleDelete" prefWidth="90.0"
                                                style="-fx-background-color: #c0392b;" text="Delete" textFill="WHITE" />
                                    </children>
                                </HBox>

                                <!-- Search Row -->
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <TextField fx:id="searchField" promptText="Search by Company Name" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleSearch" text="Search"
                                                style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
                                    </children>
                                </HBox>

                                <!-- Status Label -->
                                <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #7f8c8d;" />
                            </children>
                        </VBox>

                        <!-- Right Panel - Table -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <!-- Toolbar -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="View Mode:" />
                                        <ToggleButton fx:id="joinToggleButton" text="Show Company Name"
                                                      style="-fx-background-color: #8e44ad; -fx-text-fill: white;" />

                                        <Separator orientation="VERTICAL" prefHeight="30.0" />

                                        <Button onAction="#handleRefresh" text="Refresh Table"
                                                style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                                    </children>
                                </HBox>

                                <!-- Table -->
                                <TableView fx:id="rentalTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRentalId" prefWidth="80.0" text="Rental ID" />
                                        <TableColumn fx:id="colContractorId" prefWidth="100.0" text="Contractor ID" />
                                        <TableColumn fx:id="colContractorName" prefWidth="200.0" text="Company Name" />
                                        <TableColumn fx:id="colStartDate" prefWidth="120.0" text="Start Date" />
                                        <TableColumn fx:id="colEndDate" prefWidth="120.0" text="End Date" />
                                        <TableColumn fx:id="colTotalCost" prefWidth="100.0" text="Total Cost" />
                                        <TableColumn fx:id="colTotalHours" prefWidth="100.0" text="Total Hours" />
                                        <TableColumn fx:id="colRentalStatus" prefWidth="150.0" text="Rental Status" />
                                    </columns>
                                    <placeholder>
                                        <Label text="No rental agreements found. Click Refresh to load data." />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>